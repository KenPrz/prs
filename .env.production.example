# Copy to .env on the server and fill in every CHANGE_ME.

APP_NAME=OpenPRS
APP_ENV=production
APP_KEY=            # generated in step 6 — never reuse a dev key
APP_DEBUG=false
APP_URL=https://prs.example.com
APP_DOMAIN=prs.example.com   # used by Caddy for TLS

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=prs
DB_USERNAME=prs
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

# Media stays on the private local disk — do NOT set MEDIA_DISK=public.
FILESYSTEM_DISK=local

# Real mailer — example uses Hostinger's SMTP; any SMTP/SES/Resend works.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@prs.example.com
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@prs.example.com
MAIL_FROM_NAME="${APP_NAME}"

# In-cluster Carbone PDF renderer (service name from compose.prod.yaml).
CARBONE_BASE_URL=http://carbone:4000
# Days to retain access-log rows before model:prune deletes them.
ACCESS_LOG_RETENTION_DAYS=180